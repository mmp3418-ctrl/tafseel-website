{
  "name": "tafasil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/post-export.mjs && node -e \"require('fs').writeFileSync('out/.nojekyll', '')\"",
